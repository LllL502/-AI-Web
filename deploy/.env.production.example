DJANGO_PUBLIC_TEST=false
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
MYSQL_DATABASE=campustrace
MYSQL_USER=campustrace
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
DEMO_BASE_DATE=2026-08-20T08:00:00+08:00
AMAP_WEB_KEY=
AMAP_SECURITY_CODE=


# AI services are installed separately. Loopback settings are not a remote GPU deployment.
